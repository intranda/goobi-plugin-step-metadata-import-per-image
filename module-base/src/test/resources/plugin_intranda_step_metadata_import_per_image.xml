<config_plugin>
    <!--
        order of configuration is:
          1.) project name and step name matches
          2.) step name matches and project is *
          3.) project name matches and step name is *
          4.) project name and step name are *
    -->

    <config>
        <!-- which projects to use for (can be more than one, otherwise use *) -->
        <project>*</project>
        <step>*</step>

        <!-- Path to the Excel file; overridden programmatically in tests -->
        <excelFile>/tmp/test_import.xlsx</excelFile>

        <!-- Column header name used as physical page label -->
        <columnLabel>Label</columnLabel>

        <!-- Metadata type name used for storing the pagination label on physical pages -->
        <paginationLabelMetadata>logicalPageNumber</paginationLabelMetadata>

        <!--
            Hierarchy using struct types available in the test ruleset.
            Volume (root) > Chapter (ArchivalObject) > Chapter (Folder) > Figure (Item)
        -->
        <hierarchy>
            <level structType="Chapter" groupByColumn="URI" metadataField="TitleDocMain" matchMetadata="TitleDocMain"/>
            <level structType="Chapter" groupByColumn="Structure" metadataField="TitleDocMain" fallbackTitle="Unnamed folder" matchMetadata="TitleDocMain"/>
            <level structType="Figure" groupByColumn="Caption" metadataField="TitleDocMain" matchMetadata="TitleDocMain"/>
        </hierarchy>
    </config>

</config_plugin>
