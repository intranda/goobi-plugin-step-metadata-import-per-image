<config_plugin>
    <!--
        order of configuration is:
          1.) project name and step name matches
          2.) step name matches and project is *
          3.) project name matches and step name is *
          4.) project name and step name are *
    -->

    <config>
        <!-- which projects to use for (can be more than one, otherwise use *) -->
        <project>*</project>
        <step>*</step>

        <!-- Path to the Excel file (.xlsx). Supports Goobi variable replacement, e.g. {processfolder} -->
        <excelFile>{folder.images.import}metadata.xlsx</excelFile>

        <!-- Column header name in the Excel file whose value is used as the physical page label (ORDERLABEL) -->
        <columnLabel>Label</columnLabel>

        <!-- Metadata type name used for storing the pagination label on physical pages -->
        <paginationLabelMetadata>logicalPageNumber</paginationLabelMetadata>

        <!--
            Ordered hierarchy levels to create beneath the logical root element.
            Attributes:
              structType       - DocStruct type name as defined in the ruleset
              groupByColumn    - Excel column header whose value determines when a new element is started
              metadataField    - Metadata type to assign the group key as value (optional)
              fallbackTitle    - Value to use when the column is empty (optional)
              matchMetadata    - Metadata type on existing elements to match against the Excel column value
                                 when reusing elements (optional; if absent, positional matching is used)
              matchMode        - Comparison strategy: exact (default), endsWith, startsWith, contains
              matchDirection   - Which value the matchMode operates on:
                                 metadataMatchesExcel (default) — metadata value is tested against Excel value
                                 excelMatchesMetadata — Excel value is tested against metadata value

            Child elements (optional, any number):
              <metadata column="…" type="…"/>
                       - Imports an additional Excel column as extra metadata on this level's element.
                         column - Excel column header whose value is used.
                         type   - Metadata type name from the ruleset.
                         The value is taken from the first row of each group; empty values are skipped;
                         additional metadata is only set on newly created elements, not on reused ones.
        -->
        <hierarchy>
            <level structType="ArchivalObject" groupByColumn="URI" metadataField="TitleDocMain" matchMetadata="AeonResourceId" matchMode="endsWith"/>
            <level structType="ArchivalFolder" groupByColumn="Structure" metadataField="TitleDocMain" fallbackTitle="Unnamed folder">
                <metadata column="Call Number" type="shelfmarksource"/>
                <metadata column="URI" type="_urn"/>
            </level>
            <level structType="ArchivalItem" groupByColumn="Caption" metadataField="TitleDocMain">
                <metadata column="Studio Notes" type="NoteSource"/>
            </level>
        </hierarchy>
    </config>

    <config>
        <project>Manuscript_Project</project>
        <step>Metadata enrichment</step>

        <excelFile>{importpath}metadata.xlsx</excelFile>
        <columnLabel>Seitenlabel</columnLabel>
        <paginationLabelMetadata>logicalPageNumber</paginationLabelMetadata>

        <hierarchy>
            <level structType="Chapter" groupByColumn="Kapitel"
                metadataField="TitleDocMain" fallbackTitle="Ohne Kapitel"/>
            <level structType="Figure" groupByColumn="Abbildung"
                metadataField="TitleDocMain" fallbackTitle="Ohne Bezeichnung">
                <metadata column="Fotograf" type="Photographer"/>
                <metadata column="URN" type="_urn"/>
            </level>
        </hierarchy>
    </config>
</config_plugin>